<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.1.0</VersionPrefix>
    <Version Condition="'$(Version)' == ''">$(VersionPrefix)</Version>
    <Product>Mouse Keyboard Macro Recorder</Product>
    <Description>Local Windows automation for recording and replaying mouse and keyboard input.</Description>
    <Company>Mouse Keyboard Macro Recorder contributors</Company>
  </PropertyGroup>
</Project>
