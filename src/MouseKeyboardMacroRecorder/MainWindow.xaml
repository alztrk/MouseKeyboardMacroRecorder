<Window x:Class="MouseKeyboardMacroRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:core="clr-namespace:MouseKeyboardMacroRecorder.Core.Application;assembly=MouseKeyboardMacroRecorder.Core"
        xmlns:local="clr-namespace:MouseKeyboardMacroRecorder"
        xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        Title="{x:Static core:ProductInfo.DisplayName}"
        Width="{x:Static local:UiMetrics.DefaultWindowWidth}"
        Height="{x:Static local:UiMetrics.DefaultWindowHeight}"
        MinWidth="{x:Static local:UiMetrics.MinimumWindowWidth}"
        MinHeight="{x:Static local:UiMetrics.MinimumWindowHeight}"
        WindowStyle="None"
        ResizeMode="CanResize"
        Opacity="0"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing"
        Closed="Window_Closed"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource CanvasBrush}"
          TextElement.Foreground="{DynamicResource InkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="{StaticResource TitleBarPadding}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30"
                            Height="30"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="{StaticResource SmallRadius}"
                            Margin="0,0,8,0">
                        <Grid Width="30" Height="30">
                            <Path Data="M25 17v38l10.5-9.6 7.2 20.8 8-2.8-7.3-20.4H60L25 17Z"
                                  Fill="White"
                                  Stretch="Uniform"
                                  Width="17"
                                  Height="21"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Margin="4.5,4.5,0,0" />
                            <Border Width="7"
                                    Height="7"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="1.5"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,4,4,0">
                                <Border Width="4"
                                        Height="1.5"
                                        Background="{DynamicResource AccentBrush}"
                                        CornerRadius="0.75"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="{x:Static core:ProductInfo.DisplayName}"
                               Style="{StaticResource TitleBarTextStyle}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="ThemeButton"
                            Style="{StaticResource WindowButtonStyle}"
                            Click="ThemeButton_Click"
                            ToolTip="Use dark theme">
                        <materialIcons:MaterialIcon x:Name="ThemeIcon"
                                                    Kind="ThemeLightDark"
                                                    Width="15"
                                                    Height="15" />
                    </Button>
                    <Button Style="{StaticResource WindowButtonStyle}"
                            Click="MinimizeButton_Click"
                            ToolTip="Minimize">
                        <materialIcons:MaterialIcon Kind="WindowMinimize"
                                                    Width="14"
                                                    Height="14" />
                    </Button>
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource WindowButtonStyle}"
                            Click="MaximizeButton_Click"
                            ToolTip="Maximize">
                        <materialIcons:MaterialIcon x:Name="MaximizeIcon"
                                                    Kind="WindowMaximize"
                                                    Width="14"
                                                    Height="14" />
                    </Button>
                    <Button Style="{StaticResource CloseWindowButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="Close">
                        <materialIcons:MaterialIcon Kind="Close"
                                                    Width="15"
                                                    Height="15" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />

        <Grid x:Name="ContentGrid"
              Grid.Row="2"
              Margin="16,14,16,16"
              Background="{DynamicResource CanvasBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlRadius}"
                    Padding="{StaticResource ToolbarPadding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="RecordButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="RecordButton_Click"
                                MinWidth="112"
                                Margin="0,0,7,0"
                                ToolTip="Start recording">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon x:Name="RecordButtonIcon"
                                                            Kind="RecordCircleOutline"
                                                            Width="15"
                                                            Height="15"
                                                            Margin="0,0,7,0" />
                                <TextBlock x:Name="RecordButtonText" Text="Record" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PlayButton"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="PlayButton_Click"
                                MinWidth="86"
                                Margin="0,0,7,0"
                                ToolTip="Play selected macro">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon x:Name="PlayButtonIcon"
                                                            Kind="Play"
                                                            Width="15"
                                                            Height="15"
                                                            Margin="0,0,7,0" />
                                <TextBlock x:Name="PlayButtonText" Text="Play" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopButton"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="StopButton_Click"
                                MinWidth="86"
                                ToolTip="Stop active automation (Esc)">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="Stop"
                                                            Width="15"
                                                            Height="15"
                                                            Margin="0,0,7,0" />
                                <TextBlock Text="Stop" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="ShortcutHint"
                                   Text=""
                                   Style="{StaticResource ToolbarHintTextStyle}"
                                   Margin="0,0,12,0" />
                        <Button x:Name="HotkeysButton"
                                Style="{StaticResource TertiaryButtonStyle}"
                                Click="HotkeysButton_Click"
                                Margin="0,0,6,0"
                                ToolTip="Configure global hotkeys">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="Keyboard"
                                                            Width="14"
                                                            Height="14"
                                                            Margin="0,0,6,0" />
                                <TextBlock Text="Hotkeys" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="MacroModeButton"
                                Style="{StaticResource ActiveModeButtonStyle}"
                                Click="MacroModeButton_Click"
                                MinWidth="100"
                                Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="PlaylistPlay"
                                                            Width="15"
                                                            Height="15"
                                                            Margin="0,0,7,0" />
                                <TextBlock Text="Macros" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AutoClickerModeButton"
                                Style="{StaticResource ModeButtonStyle}"
                                Click="AutoClickerModeButton_Click"
                                MinWidth="116">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="Mouse"
                                                            Width="15"
                                                            Height="15"
                                                            Margin="0,0,7,0" />
                                <TextBlock Text="Auto clicker" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource SurfaceRadius}"
                    Padding="{StaticResource CardPadding}">
                <Grid>
                    <Grid x:Name="MacroSurface"
                          SizeChanged="MacroSurface_SizeChanged">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="MacroSettingsColumn" Width="{x:Static local:UiMetrics.MacroSettingsColumnWidth}" />
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="MacroListPanel"
                              Grid.Row="0"
                              Grid.Column="0"
                              Margin="{StaticResource PanelGutter}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="Macros"
                                           Style="{StaticResource SectionTitleTextStyle}" />
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button x:Name="ImportButton"
                                            Style="{StaticResource TertiaryButtonStyle}"
                                            Click="ImportButton_Click"
                                            ToolTip="Import .macro.json files">
                                        <StackPanel Orientation="Horizontal">
                                            <materialIcons:MaterialIcon Kind="Import"
                                                                        Width="14"
                                                                        Height="14"
                                                                        Margin="0,0,6,0" />
                                            <TextBlock Text="Import" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ExportButton"
                                            Style="{StaticResource TertiaryButtonStyle}"
                                            Click="ExportButton_Click"
                                            IsEnabled="False"
                                            ToolTip="Export selected macro">
                                        <StackPanel Orientation="Horizontal">
                                            <materialIcons:MaterialIcon Kind="Export"
                                                                        Width="14"
                                                                        Height="14"
                                                                        Margin="0,0,6,0" />
                                            <TextBlock Text="Export" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border x:Name="EmptyMacroState"
                                    Grid.Row="2"
                                    Background="{DynamicResource CanvasBrush}"
                                    CornerRadius="{StaticResource ControlRadius}"
                                    Padding="{StaticResource EmptyStatePadding}">
                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            MaxWidth="360">
                                    <materialIcons:MaterialIcon Kind="PlaylistPlus"
                                                                Width="30"
                                                                Height="30"
                                                                Foreground="{DynamicResource AccentBrush}"
                                                                HorizontalAlignment="Center" />
                                    <TextBox Text="Nothing saved yet"
                                             Style="{StaticResource EmptyStateTitleStyle}"
                                             TextAlignment="Center"
                                             Margin="0,14,0,0" />
                                    <Button x:Name="RecordNewMacroButton"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="RecordButton_Click"
                                            HorizontalAlignment="Center"
                                            Margin="0,18,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialIcons:MaterialIcon Kind="RecordCircleOutline"
                                                                        Width="15"
                                                                        Height="15"
                                                                        Margin="0,0,7,0" />
                                            <TextBlock Text="Record a new macro" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border x:Name="MacroDataPanel"
                                    Grid.Row="2"
                                    Background="{DynamicResource CanvasBrush}"
                                    CornerRadius="{StaticResource ControlRadius}"
                                    Padding="10"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="78" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <ListBox x:Name="MacroItemsList"
                                             Grid.Row="0"
                                             Style="{StaticResource ListBoxSurfaceStyle}"
                                             ItemContainerStyle="{StaticResource ListItemStyle}"
                                             SelectionChanged="MacroItemsList_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="24"
                                                            Height="24"
                                                            CornerRadius="6"
                                                            Background="{DynamicResource AccentSoftBrush}"
                                                            VerticalAlignment="Center">
                                                        <materialIcons:MaterialIcon Kind="PlaylistPlay"
                                                                                    Width="14"
                                                                                    Height="14"
                                                                                    Foreground="{DynamicResource AccentBrush}"
                                                                                    HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1"
                                                                Margin="8,0,8,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource InkBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Meta}"
                                                                   Margin="0,2,0,0"
                                                                   Style="{StaticResource ToolbarHintTextStyle}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding ActionCountText}"
                                                               Style="{StaticResource ToolbarHintTextStyle}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,7,0" />
                                                    <Button Grid.Column="3"
                                                            Style="{StaticResource WindowButtonStyle}"
                                                            Width="28"
                                                            Height="28"
                                                            Tag="{Binding}"
                                                            Click="RemoveMacroButton_Click"
                                                            ToolTip="Remove from this list">
                                                        <materialIcons:MaterialIcon Kind="Close"
                                                                                    Width="13"
                                                                                    Height="13" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Border Grid.Row="1"
                                            Height="1"
                                            Background="{DynamicResource BorderBrush}"
                                            Margin="0,5,0,8" />

                                    <Grid Grid.Row="2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="SelectedMacroTitle"
                                                       Style="{StaticResource FieldLabelTextStyle}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource InkBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="SelectedMacroMeta"
                                                       Style="{StaticResource ToolbarHintTextStyle}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right">
                                            <Button x:Name="MoveActionUpButton"
                                                    Style="{StaticResource WindowButtonStyle}"
                                                    Width="28"
                                                    Height="28"
                                                    Click="MoveActionUpButton_Click"
                                                    ToolTip="Move action up">
                                                <materialIcons:MaterialIcon Kind="ChevronUp"
                                                                            Width="14"
                                                                            Height="14" />
                                            </Button>
                                            <Button x:Name="MoveActionDownButton"
                                                    Style="{StaticResource WindowButtonStyle}"
                                                    Width="28"
                                                    Height="28"
                                                    Click="MoveActionDownButton_Click"
                                                    ToolTip="Move action down">
                                                <materialIcons:MaterialIcon Kind="ChevronDown"
                                                                            Width="14"
                                                                            Height="14" />
                                            </Button>
                                            <Button x:Name="RemoveActionButton"
                                                    Style="{StaticResource WindowButtonStyle}"
                                                    Width="28"
                                                    Height="28"
                                                    Click="RemoveActionButton_Click"
                                                    ToolTip="Remove action">
                                                <materialIcons:MaterialIcon Kind="DeleteOutline"
                                                                            Width="14"
                                                                            Height="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <ListBox x:Name="MacroActionsList"
                                             Grid.Row="3"
                                             Margin="0,5,0,0"
                                             Style="{StaticResource ListBoxSurfaceStyle}"
                                             ItemContainerStyle="{StaticResource ListItemStyle}"
                                             SelectionChanged="MacroActionsList_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="24"
                                                            Height="24"
                                                            CornerRadius="6"
                                                            Background="{DynamicResource SurfaceBrush}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding IndexText}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource SubtleInkBrush}"
                                                                   FontSize="11" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Summary}"
                                                               Foreground="{DynamicResource InkBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding DelayText}"
                                                               Style="{StaticResource ToolbarHintTextStyle}"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border x:Name="MacroDivider"
                                Grid.Row="0"
                                Grid.Column="1"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1,0,0,0"
                                Padding="{StaticResource SettingsPanelPadding}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="MacroSettingsPanel" Margin="0,2,0,0">
                                    <TextBlock Text="Quick settings"
                                               Style="{StaticResource SubsectionTitleTextStyle}" />
                                    <TextBlock Text="Playback"
                                               Style="{StaticResource SectionLabelStyle}"
                                               Margin="0,20,0,8" />
                                    <TextBlock Text="Repeat"
                                               Style="{StaticResource FieldLabelTextStyle}" />
                                    <ComboBox x:Name="PlaybackRepeatComboBox"
                                              Style="{StaticResource SelectStyle}"
                                              Margin="0,6,0,0"
                                              SelectionChanged="PlaybackRepeatComboBox_SelectionChanged">
                                        <ComboBoxItem Tag="once">Once</ComboBoxItem>
                                        <ComboBoxItem Tag="count:2">2 times</ComboBoxItem>
                                        <ComboBoxItem Tag="count:5">5 times</ComboBoxItem>
                                        <ComboBoxItem Tag="count:10">10 times</ComboBoxItem>
                                        <ComboBoxItem Tag="until_stopped">Until stopped</ComboBoxItem>
                                    </ComboBox>
                                    <TextBlock Text="Speed"
                                               Style="{StaticResource FieldLabelTextStyle}"
                                               Margin="0,16,0,0" />
                                    <ComboBox x:Name="PlaybackSpeedComboBox"
                                              Style="{StaticResource SelectStyle}"
                                              Margin="0,6,0,0"
                                              SelectionChanged="PlaybackSpeedComboBox_SelectionChanged">
                                        <ComboBoxItem Tag="0.5">0.5×</ComboBoxItem>
                                        <ComboBoxItem Tag="0.75">0.75×</ComboBoxItem>
                                        <ComboBoxItem Tag="1">1×</ComboBoxItem>
                                        <ComboBoxItem Tag="1.5">1.5×</ComboBoxItem>
                                        <ComboBoxItem Tag="2">2×</ComboBoxItem>
                                    </ComboBox>
                                    <TextBlock Text="Between loops, milliseconds"
                                               Style="{StaticResource FieldLabelTextStyle}"
                                               Margin="0,16,0,8" />
                                    <TextBox x:Name="PlaybackInterLoopDelayTextBox"
                                             Text="0"
                                             Style="{StaticResource InputStyle}"
                                             PreviewTextInput="NumericTextBox_PreviewTextInput"
                                             TextChanged="PlaybackInterLoopDelayTextBox_TextChanged" />
                                    <TextBlock Text="Record"
                                               Style="{StaticResource SectionLabelStyle}"
                                               Margin="0,18,0,6" />
                                    <CheckBox x:Name="CaptureMouseCheckBox"
                                              Style="{StaticResource CheckBoxStyle}"
                                              Content="Mouse movement and clicks"
                                              Checked="RecordingOption_Changed"
                                              Unchecked="RecordingOption_Changed" />
                                    <CheckBox x:Name="CaptureKeyboardCheckBox"
                                              Style="{StaticResource CheckBoxStyle}"
                                              Content="Keyboard input"
                                              Checked="RecordingOption_Changed"
                                              Unchecked="RecordingOption_Changed" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Grid x:Name="AutoClickerSurface"
                          Visibility="Collapsed"
                          SizeChanged="AutoClickerSurface_SizeChanged">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="AutoClickerSettingsColumn" Width="{x:Static local:UiMetrics.AutoClickerSettingsColumnWidth}" />
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="AutoClickerMainPanel"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="{StaticResource PanelGutter}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="420">
                            <materialIcons:MaterialIcon Kind="Mouse"
                                                        Width="32"
                                                        Height="32"
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        HorizontalAlignment="Center" />
                            <TextBlock Text="Auto clicker"
                                       Style="{StaticResource FeatureTitleTextStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0" />
                            <TextBlock x:Name="AutoClickerStatusText"
                                       Text="Ready"
                                       Style="{StaticResource ToolbarHintTextStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0" />
                            <Border Background="{DynamicResource CanvasBrush}"
                                    CornerRadius="{StaticResource ControlRadius}"
                                    Padding="{StaticResource CardPadding}"
                                    Margin="0,20,0,0">
                                <Button x:Name="AutoClickerStartButton"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="AutoClickerStartButton_Click"
                                        HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <materialIcons:MaterialIcon x:Name="AutoClickerStartIcon"
                                                                    Kind="Mouse"
                                                                    Width="15"
                                                                    Height="15"
                                                                    Margin="0,0,7,0" />
                                        <TextBlock x:Name="AutoClickerStartText" Text="Start auto clicker" />
                                    </StackPanel>
                                </Button>
                            </Border>
                        </StackPanel>

                        <Border x:Name="AutoClickerDivider"
                                Grid.Row="0"
                                Grid.Column="1"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1,0,0,0"
                                Padding="{StaticResource SettingsPanelPadding}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,2,0,0">
                                    <TextBlock Text="Click settings"
                                               Style="{StaticResource SubsectionTitleTextStyle}" />
                                    <TextBlock Text="Button"
                                               Style="{StaticResource SectionLabelStyle}"
                                               Margin="0,20,0,8" />
                                    <ComboBox x:Name="AutoButtonComboBox"
                                              Style="{StaticResource SelectStyle}"
                                              SelectionChanged="AutoOption_Changed">
                                        <ComboBoxItem Tag="left">Left button</ComboBoxItem>
                                        <ComboBoxItem Tag="right">Right button</ComboBoxItem>
                                        <ComboBoxItem Tag="middle">Middle button</ComboBoxItem>
                                    </ComboBox>
                                    <TextBlock Text="Interval, milliseconds"
                                               Style="{StaticResource FieldLabelTextStyle}"
                                               Margin="0,16,0,8" />
                                    <TextBox x:Name="AutoIntervalTextBox"
                                             Text="100"
                                             Style="{StaticResource InputStyle}"
                                             PreviewTextInput="NumericTextBox_PreviewTextInput"
                                             TextChanged="AutoOption_Changed" />
                                    <TextBlock Text="Repeat"
                                               Style="{StaticResource FieldLabelTextStyle}"
                                               Margin="0,16,0,8" />
                                    <ComboBox x:Name="AutoRepeatComboBox"
                                              Style="{StaticResource SelectStyle}"
                                              SelectionChanged="AutoOption_Changed">
                                        <ComboBoxItem Tag="once">Once</ComboBoxItem>
                                        <ComboBoxItem Tag="count:10">10 clicks</ComboBoxItem>
                                        <ComboBoxItem Tag="count:100">100 clicks</ComboBoxItem>
                                        <ComboBoxItem Tag="until_stopped">Until stopped</ComboBoxItem>
                                    </ComboBox>
                                    <TextBlock Text="Position"
                                               Style="{StaticResource FieldLabelTextStyle}"
                                               Margin="0,16,0,8" />
                                    <ComboBox x:Name="AutoPositionComboBox"
                                              Style="{StaticResource SelectStyle}"
                                              SelectionChanged="AutoPositionComboBox_SelectionChanged">
                                        <ComboBoxItem Tag="current">Current cursor</ComboBoxItem>
                                        <ComboBoxItem Tag="fixed">Fixed position</ComboBoxItem>
                                    </ComboBox>
                                    <Grid x:Name="FixedPositionPanel"
                                          Visibility="Collapsed"
                                          Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="X"
                                                       Style="{StaticResource SectionLabelStyle}"
                                                       Margin="0,0,0,5" />
                                            <TextBox x:Name="AutoXTextBox"
                                                     Text="0"
                                                     Style="{StaticResource InputStyle}"
                                                     PreviewTextInput="NumericTextBox_PreviewTextInput"
                                                     TextChanged="AutoOption_Changed" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Y"
                                                       Style="{StaticResource SectionLabelStyle}"
                                                       Margin="0,0,0,5" />
                                            <TextBox x:Name="AutoYTextBox"
                                                     Text="0"
                                                     Style="{StaticResource InputStyle}"
